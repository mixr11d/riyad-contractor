# Cloudflare Pages Headers Configuration
# Optimized for 100/100 Core Web Vitals, Strict Security & Zero Glitches

# Global Security & Policy Headers for all pages
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self' https: data: 'unsafe-inline' 'unsafe-eval'; img-src 'self' https: data: blob:; script-src 'self' https://www.googletagmanager.com https://www.google-analytics.com 'unsafe-inline' 'unsafe-eval'; connect-src 'self' https://www.google-analytics.com https://*.google-analytics.com https://stats.g.doubleclick.net;

# HTML documents caching (Fresh content delivery)
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Core JavaScript (No query param dependency, immediate validation)
/script.js
  Cache-Control: public, max-age=3600, must-revalidate
  Content-Type: application/javascript; charset=utf-8

# Master Stylesheet
/style.css
  Cache-Control: public, max-age=3600, must-revalidate
  Content-Type: text/css; charset=utf-8

# Static Optimized Images (Long-term immutable caching)
/images/*
  Cache-Control: public, max-age=31536000, immutable

# WhatsApp & Social Preview Image
/preview.jpeg
  Cache-Control: public, max-age=86400

/preview.png
  Cache-Control: public, max-age=86400

# XML Sitemap, Robots, and LLM Manifests
/sitemap.xml
  Cache-Control: public, max-age=86400
  Content-Type: application/xml; charset=utf-8

/robots.txt
  Cache-Control: public, max-age=86400
  Content-Type: text/plain; charset=utf-8

/llms.txt
  Cache-Control: public, max-age=86400
  Content-Type: text/plain; charset=utf-8
